local lspconfig = require("lspconfig")
local util = require("lspconfig.util")

-- Path to wrapper we created
local wrapper = vim.fn.expand("~/.local/bin/jdtls-java21")

-- sanity check: warn if wrapper missing
if vim.fn.executable(wrapper) == 0 then
    vim.notify("jdtls wrapper not found: " .. wrapper .. ". Make sure ~/.local/bin/jdtls-java21 exists and is executable.", vim.log.levels.ERROR)
    return
end

local root_dir = util.root_pattern(".git", "mvnw", "gradlew", "pom.xml", "build.gradle")

lspconfig.jdtls.setup({
    cmd = { wrapper },
    root_dir = root_dir,
    on_attach = function(client, bufnr)
        -- example minimal on_attach
        local opts = { noremap=true, silent=true }
        vim.api.nvim_buf_set_keymap(bufnr, "n", "gd", "<cmd>lua vim.lsp.buf.definition()<CR>", opts)
    end,
    settings = {
        java = {}
    },
})
